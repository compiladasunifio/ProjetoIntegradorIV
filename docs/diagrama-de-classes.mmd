classDiagram
    direction LR

    class Vendedor {
        +number id
        +string nome
        +string email
        +string senhaHash
        +string telefone
        +string nomeNegocio
        +string localizacao
    }

    class Produto {
        +number id
        +string nome
        +string descricao
        +number preco
        +string imagemUrl
        +boolean disponivel
        +string localizacao
        +number vendedorId
    }

    class Avaliacao {
        +number id
        +number produtoId
        +string autorNome
        +number nota
        +string comentario
        +string data
    }

    class HorarioAtendimento {
        +number id
        +number vendedorId
        +string dia
        +string inicio
        +string fim
        +string local
    }

    Vendedor "1" *-- "0..*" Produto : vende
    Vendedor "1" *-- "0..*" HorarioAtendimento : atende em
    Produto "1" *-- "0..*" Avaliacao : recebe
