classDiagram
    direction TB

    class Vendedor {
        +id: int
        +nome: string
        +email: string
        +senhaHash: string
        +telefone: string
        +nomeNegocio: string
        +localizacao: string
        +cadastrar()
        +login()
        +editarPerfil()
        +alterarSenha()
        +excluirConta()
    }

    class Produto {
        +id: int
        +nome: string
        +descricao: string
        +preco: float
        +imagemUrl: string
        +disponivel: boolean
        +localizacao: string
        +vendedorId: int
        +cadastrar()
        +editar()
        +excluir()
        +alterarDisponibilidade()
    }

    class Avaliacao {
        +id: int
        +produtoId: int
        +autorNome: string
        +nota: int
        +comentario: string
        +data: date
        +publicar()
        +editar()
        +excluir()
    }

    class HorarioAtendimento {
        +id: int
        +vendedorId: int
        +dia: string
        +inicio: string
        +fim: string
        +local: string
        +adicionar()
        +editar()
        +excluir()
    }

    Vendedor "1" -- "0..*" Produto
    Vendedor "1" -- "0..*" HorarioAtendimento
    Produto "1" -- "0..*" Avaliacao

    style Vendedor fill:#e6e6e6,stroke:#555555
    style Produto fill:#c8f5c8,stroke:#3a8a3a
    style Avaliacao fill:#cde4ff,stroke:#3a6ea5
    style HorarioAtendimento fill:#ffe0c2,stroke:#c0702a
